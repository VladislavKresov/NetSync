<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>NetSync</RootNamespace>
    <AssemblyName>NetSync</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- net8.0: trimming / NativeAOT analyzers on (warnings are errors) — the core uses no reflection. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- NuGet package -->
  <PropertyGroup>
    <PackageId>NetSync</PackageId>
    <Version>2.0.0-rc.4</Version>
    <Authors>Vladislav Kresov</Authors>
    <Description>Universal zero-dependency networking core for .NET: TCP+UDP channels over one connection, reliable UDP with packet batching, every packet authenticated (AES-GCM or HMAC), server identity pinning, connection approval, WebSocket transport for browsers, a relay with UDP hole punching, time sync and LAN discovery — with zero allocations per message. netstandard2.1 (Unity 2021.2+) and net8.0 (NativeAOT), one wire protocol.</Description>
    <PackageTags>networking;multiplayer;game-networking;tcp;udp;reliable-udp;websocket;relay;nat-traversal;hole-punching;encryption;unity;file-transfer</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile Condition="Exists('..\..\README.md')">README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/VladislavKresov/NetSync</RepositoryUrl>
    <PackageProjectUrl>https://github.com/VladislavKresov/NetSync</PackageProjectUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- Zero runtime dependencies: BCL only. Do not add PackageReference here. -->

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Condition="Exists('..\..\README.md')" />
    <InternalsVisibleTo Include="NetSync.Tests" />
    <InternalsVisibleTo Include="NetSync.Tests.NetStandard" />
    <InternalsVisibleTo Include="NetSync.Benchmarks" />
  </ItemGroup>

</Project>
