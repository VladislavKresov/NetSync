<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <!-- Measurements use Stopwatch + GC counters (no benchmarking framework). LiteNetLib is here
       only as the comparison baseline (`compare`); the NetSync core itself has no dependencies. -->

  <ItemGroup>
    <ProjectReference Include="..\..\src\NetSync\NetSync.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LiteNetLib" Version="2.1.4" />
  </ItemGroup>

</Project>
