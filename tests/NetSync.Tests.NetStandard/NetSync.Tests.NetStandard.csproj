<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs the exact same test suite against the netstandard2.1 build of the core
    (the one Unity uses), so code paths behind #if NET8_0_OR_GREATER are covered
    for both targets. It runs on the .NET 8 runtime: it verifies the netstandard2.1
    compilation, not Mono/IL2CPP runtime behavior.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>NetSync.Tests.NetStandard</AssemblyName>
    <RootNamespace>NetSync.Tests</RootNamespace>
    <!-- Lets tests state target-specific expectations (e.g. allocation budgets). -->
    <DefineConstants>$(DefineConstants);CORE_NETSTANDARD</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\NetSync.Tests\**\*.cs" Exclude="..\NetSync.Tests\bin\**;..\NetSync.Tests\obj\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.8.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NetSync\NetSync.csproj" SetTargetFramework="TargetFramework=netstandard2.1" />
  </ItemGroup>

</Project>
